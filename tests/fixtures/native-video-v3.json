    "CreateVideo": {
      "input": {
        "required": {
          "images": [
            "IMAGE",
            {
              "tooltip": "The images to create a video from."
            }
          ],
          "fps": [
            "FLOAT",
            {
              "default": 30.0,
              "min": 1.0,
              "max": 120.0,
              "step": 1.0
            }
          ]
        },
